JWT_SECRET=change-me-to-a-random-64-char-string
HERMES_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRAEFIK_HOST=
DESKRPG_IMAGE=ghcr.io/dandacompany/deskrpg:latest
HERMES_DASHBOARD_PASSWORD=
# Tier 0 is mandatory for the first two Kanban iterations. The defaults target a local MLX
# provider; set these only when the gateway exposes a different local provider/model.
DESKRPG_TIER0_PROVIDER=mlx
DESKRPG_TIER0_MODEL=Qwen2.5-Coder-7B-Instruct-4bit
# Tier 2 is released only after the threshold and an explicit uncertainty signal.
DESKRPG_TIER2_PROVIDER=openrouter
DESKRPG_TIER2_MODEL=deepseek/deepseek-r1
DESKRPG_TIER2_UNCERTAINTY_ITERATIONS=2
